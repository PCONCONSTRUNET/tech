generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("VENDEDOR") // ADMIN, VENDEDOR, TECNICO, FINANCEIRO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  document  String?  // CPF/CNPJ
  phone     String?
  whatsapp  String?
  email     String?
  birthDate String?
  cep       String?
  street    String?
  number    String?
  complement String?
  neighborhood String?
  city      String?
  state     String?
  notes     String?
  
  serviceOrders ServiceOrder[]
  sales         Sale[]
  transactions  Transaction[]
  quotes        Quote[]
  payments      Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceOrder {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  
  device      String
  brand       String
  model       String
  imei        String?
  defect      String
  diagnostic  String?
  photos      String? // Could be JSON array of URLs
  price       Float?
  status      String  @default("RECEBIDO") // RECEBIDO, EM_ANALISE, AGUARDANDO_APROVACAO, AGUARDANDO_PECA, EM_CONSERTO, PRONTO, ENTREGUE, CANCELADO
  warranty    String?
  notes       String?

  items       ServiceOrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  document  String?
  phone     String?
  whatsapp  String?
  cep       String?
  street    String?
  number    String?
  neighborhood String?
  city      String?
  state     String?
  products  Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String    @id @default(cuid())
  name          String
  description   String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  photoUrl      String?
  photos        String?   // JSON array de URLs das fotos
  costPrice     Float     @default(0)
  salePrice     Float     @default(0)
  stock         Int       @default(0)
  minStock      Int       @default(5)
  sku           String?   @unique
  barcode       String?
  ncm           String?
  active        Boolean   @default(true)
  showOnVitrine Boolean   @default(true)
  type          String    @default("PRODUCT") // PRODUCT, PART, etc
  
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])

  saleItems     SaleItem[]
  quoteItems    QuoteItem[]
  osItems       ServiceOrderItem[]
  stockMovements StockMovement[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Category {
  id        String    @id @default(cuid())
  name      String
  products  Product[]
}

model Sale {
  id            String     @id @default(cuid())
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  totalAmount   Float
  discount      Float      @default(0)
  paymentMethod String     // PIX, CREDIT, DEBIT, CASH
  status        String     @default("CONCLUIDO") // PENDENTE, PAGO, ENVIADO, CANCELADO, CONCLUIDO
  origin        String     @default("PDV") // PDV, LOJA_VIRTUAL
  items         SaleItem[]
  payments      SalePayment[]
  
  createdAt     DateTime   @default(now())
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model TransactionCategory {
  id        String   @id @default(cuid())
  name      String
  type      String   // RECEITA, DESPESA
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  type        String   // RECEITA, DESPESA
  amount      Float
  description String
  date        DateTime @default(now())
  status      String   @default("PAGO") // PAGO, PENDENTE
  categoryId  String?
  category    TransactionCategory? @relation(fields: [categoryId], references: [id])
  paymentMethod String?
  notes       String?
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
}

model Settings {
  id          String   @id @default(cuid())
  storeName   String
  logoUrl     String?
  whatsapp    String?
  cep       String?
  street    String?
  number    String?
  neighborhood String?
  city      String?
  state     String?
  hours       String?
  fiscalData  String?
  warrantyTerm String?
}

model Quote {
  id          String   @id @default(cuid())
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  totalAmount Float
  discount    Float    @default(0)
  validity    Int      @default(7)
  status      String   @default("PENDENTE") // PENDENTE, APROVADO, REJEITADO
  notes       String?
  items       QuoteItem[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model QuoteItem {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  quantity  Int
  price     Float
}

model Coupon {
  id        String   @id @default(cuid())
  code      String   @unique
  type      String   // PERCENTAGE, FIXED
  value     Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id            String    @id @default(cuid())
  description   String
  amount        Float
  dueDate       DateTime
  paymentDate   DateTime?
  status        String    @default("PENDENTE") // PENDENTE, PAGO, CANCELADO, ATRASADO
  type          String    // RECEBER, PAGAR
  paymentMethod String?
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Invoice {
  id            String    @id @default(cuid())
  number        String
  series        String?
  accessKey     String?   // Chave de acesso NFe/NFCe
  amount        Float
  status        String    @default("EMITIDA") // EMITIDA, CANCELADA, REJEITADA
  xmlUrl        String?
  pdfUrl        String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WhatsAppTemplate {
  id        String   @id @default(cuid())
  status    String   @unique // Ex: PENDENTE, EM_CONSERTO, CONCLUIDO, etc
  message   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CashSession {
  id            String        @id @default(cuid())
  operatorName  String
  initialAmount Float         @default(0)
  status        String        @default("ABERTO") // ABERTO, FECHADO
  closedAt      DateTime?
  movements     CashMovement[]
  createdAt     DateTime      @default(now())
}

model CashMovement {
  id          String      @id @default(cuid())
  sessionId   String
  session     CashSession @relation(fields: [sessionId], references: [id])
  type        String      // ENTRADA, SAIDA, SANGRIA, SUPRIMENTO
  amount      Float
  method      String?
  description String?
  createdAt   DateTime    @default(now())
}

model ServiceOrderItem {
  id             String       @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  name           String       @default("Serviço")
  quantity       Int
  price          Float        // Preço na hora da OS
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  type        String   // ENTRADA, SAIDA
  origin      String   // VENDA, COMPRA, OS, AJUSTE_MANUAL
  userId      String?
  notes       String?
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(cuid())
  action      String   // CREATE, UPDATE, DELETE
  entity      String   // PRODUCT, OS, SALE
  entityId    String
  userId      String
  userName    String?
  details     String?  // JSON stringified details
  createdAt   DateTime @default(now())
}

model Commission {
  id             String    @id @default(cuid())
  userId         String
  saleId         String?
  serviceOrderId String?
  amount         Float
  percentage     Float
  status         String    @default("PENDENTE") // PENDENTE, PAGO
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model SalePayment {
  id            String   @id @default(cuid())
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod String   // PIX, CREDIT, DEBIT, CASH
  installments  Int      @default(1)
  createdAt     DateTime @default(now())
}

model Gateway {
  id          String   @id @default(cuid())
  name        String   @unique // MERCADOPAGO, STRIPE, PAGARME, etc
  active      Boolean  @default(false)
  publicKey   String?
  accessToken String?
  secretKey   String?
  webhookUrl  String?
  sandbox     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
